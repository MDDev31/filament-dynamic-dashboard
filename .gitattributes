# Normalise line endings in the repository; the working copy follows each
# contributor's own Git configuration.
* text=auto

# Vendored third-party bundle.
/resources/dist/** linguist-vendored

# Development files left out of the archives Composer downloads.
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
/testbench.yaml     export-ignore
